.venv/
venv/
env/
*.egg-info/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
build/
dist/
*.spec.bak

# Training outputs and exported datasets
runs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

