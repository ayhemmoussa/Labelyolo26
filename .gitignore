# Model weights (too large for GitHub — keep locally)
*.pt
*.pth
*.safetensors
*.bin
*.onnx
*.ckpt

# Bundled Magic Label models (Grounding DINO + SAM2, ~850 MB).
# If this folder is missing, Magic Label downloads the models from Hugging Face
# on first use. See README for how to populate it before building the .exe.
labelme/labelme/models/

# Hugging Face download cache / partial downloads
.cache/
*.incomplete

